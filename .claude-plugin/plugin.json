{
  "name": "mnemosyne",
  "version": "0.1.0",
  "description": "The Agent-First Knowledge Database. 59 MCP tools for knowledge CRUD, AIKOQL queries, graph traversal, hybrid search, context compilation, document ingestion, constraint validation, and more. Embedded single binary, zero runtime deps.",
  "author": {
    "name": "Anckur Singh",
    "url": "https://github.com/anckursingh"
  },
  "homepage": "https://github.com/anckursingh/mnemosyne",
  "repository": "https://github.com/anckursingh/mnemosyne",
  "license": "Apache-2.0",
  "keywords": [
    "knowledge-graph",
    "knowledge-database",
    "mcp-server",
    "ai-agents",
    "context-compiler",
    "vector-search",
    "graph-database",
    "ontology",
    "encryption",
    "rust"
  ],
  "mcpServers": {
    "mnemosyne": {
      "command": "npx",
      "args": ["-y", "mnemosyne-mcp@latest", "serve", "--listen", "127.0.0.1:9090", "--metrics-addr", "127.0.0.1:9091"]
    }
  }
}
